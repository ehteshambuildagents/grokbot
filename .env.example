# Copy to .env and fill in. No credentials are included here.
# Native (Windows/macOS/Linux) defaults live in services/api/localcrew/config.py; everything is LOCALCREW_*.

# --- Docker Compose only ---
POSTGRES_PASSWORD=
# Long random string shared by api/worker and the computer service (native runs auto-generate .local/keys/computer.token if unset)
LOCALCREW_COMPUTER_TOKEN=

# --- Common ---
# LOCALCREW_DATABASE_URL=postgresql+psycopg://localcrew:<password>@127.0.0.1:54329/localcrew
# LOCALCREW_DATA_DIR=.local/data
# Keep the key file OUTSIDE the database backup location; back it up separately.
# LOCALCREW_SECRET_KEY_FILE=.local/keys/secrets.key
# LOCALCREW_OLLAMA_URL=http://127.0.0.1:11434
# LOCALCREW_DEFAULT_MODEL=qwen2.5:3b   (qwen2.5:1.5b = Apache-2.0, low-memory, weaker; see docs/MODELS.md)
# LOCALCREW_PUBLIC_ORIGIN=http://127.0.0.1:8000
# Set true only behind HTTPS
# LOCALCREW_SECURE_COOKIES=false
# Optional self-hosted search (SearXNG with JSON output enabled). Empty = web search unavailable.
# LOCALCREW_SEARXNG_URL=
# host:port pairs the browser/fetch tools may reach on private addresses (test fixtures only)
# LOCALCREW_PRIVATE_HOST_ALLOWLIST=127.0.0.1:8899,localhost:8899
# LOCALCREW_WORKER_CONCURRENCY=2
# LOCALCREW_MODEL_CONCURRENCY=1

# --- Optional: hosted model API instead of (or alongside) local Ollama ---
# Any OpenAI-compatible Chat Completions API. OFF by default. When a bot uses a "remote:<model>" model, its
# instructions, the conversation, retrieved memories and tool results (page text, file contents) are sent to
# that provider. Keep the key here only; it is never stored in the database or shown to models.
# LOCALCREW_REMOTE_PROVIDERS_ENABLED=true
# LOCALCREW_REMOTE_BASE_URL=https://api.openai.com/v1        # or https://openrouter.ai/api/v1, https://api.groq.com/openai/v1, ...
# LOCALCREW_REMOTE_API_KEY=
# LOCALCREW_REMOTE_MODELS=gpt-4o-mini                         # comma-separated, shown in the bot editor as remote:<id>
# LOCALCREW_DEFAULT_MODEL=remote:gpt-4o-mini                  # optional: make the API model the default for all bots
# LOCALCREW_MODEL_CONCURRENCY=2                               # APIs can run several tasks at once
